# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Run mode ----
# offline = use local fixtures, 0 credits, no network (default, for dev/demo)
# live    = real Coresignal production pull (spends credits)
JATAYU_MODE=offline

# ---- Coresignal (only needed for live mode) ----
CORESIGNAL_API_KEY=
CORESIGNAL_BASE_URL=https://api.coresignal.com/cdapi/v2

# ---- LLM rubric pass ----
# mock      = deterministic, key-free (default; reproducible demo)
# anthropic = Claude (set ANTHROPIC_API_KEY)
# openai    = GPT  (set OPENAI_API_KEY)
JATAYU_LLM_PROVIDER=mock
JATAYU_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Offline fixtures path (offline mode only) ----
JATAYU_FIXTURES=fixtures/mandate_a_raw_profiles.json
