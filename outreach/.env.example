# Copy to .env. .env is gitignored.

# mock      = deterministic template tier (default; no key, reproducible)
# anthropic = Claude bespoke tier (set ANTHROPIC_API_KEY)
# openai    = GPT bespoke tier   (set OPENAI_API_KEY)
OUTREACH_LLM_PROVIDER=mock
OUTREACH_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
